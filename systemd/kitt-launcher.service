# User-Unit: ~/.config/systemd/user/kitt-launcher.service (installiert von scripts/autostart_enable.sh)
# Wird von scripts/session_start.sh in der Wayland-Session gestartet, nicht beim Boot "enabled":
# ohne Compositor gibt es nichts anzuzeigen.
[Unit]
Description=KITT-Cart Launcher
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
ExecStart=__ROOT__/scripts/run_launcher.sh
# Absturz (Exit != 0, Signal, OOM) -> Neustart. Sauberes Ende (ESC, systemctl stop) -> bleibt aus.
Restart=on-failure
RestartSec=2
# Beim Stop die ganze Gruppe inkl. Modus-Prozessen und Servern beenden
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
