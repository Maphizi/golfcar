# User-Unit: ~/.config/systemd/user/kitt-launcher.service (wird von scripts/autostart_enable.sh installiert)
# Läuft in der Wayland-Session des Autologin-Benutzers.
[Unit]
Description=KITT-Cart Launcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
ExecStart=__ROOT__/scripts/run_launcher.sh
Restart=always
RestartSec=3
# Launcher-Kern niedrig halten, Modi erben das nicht zwingend
Nice=-5

[Install]
WantedBy=default.target
