# System-Unit: /etc/systemd/system/kitt-miracast.service (installiert von scripts/setup_miracast.sh --install)
# Läuft als root (Wi-Fi Direct über NetworkManager), das Bild greift scripts/miracast.py als Session-Benutzer ab.
# Exit 3 = WLAN ist beim Aufbau weggefallen -> kein Neustart (zweiter WLAN-Stick nötig, siehe logs/miracast_status.txt).
[Unit]
Description=KITT-Cart Miracast-Sender (Bild an den Empfänger)
After=NetworkManager.service network-online.target
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=KITT_USER=__USER__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __ROOT__/scripts/miracast.py run
ExecStopPost=-/usr/bin/nmcli connection down kitt-miracast
Restart=on-failure
RestartSec=20
RestartPreventExitStatus=3
# niedrigere Priorität als Launcher und RetroArch, damit das Spiel nicht ruckelt
Nice=5
StandardOutput=append:__ROOT__/logs/miracast.log
StandardError=append:__ROOT__/logs/miracast.log

[Install]
WantedBy=multi-user.target
